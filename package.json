{
  "name": "deepgram-youtube",
  "description": "Download a youtube video and have it transcribed with Deepgram.",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "deepgram-youtube": "./bin/deepgram-youtube"
  },
  "scripts": {
    "build": "bash ./bin/build.sh",
    "commit": "cz",
    "dist": "npm run build && cd dist && npm publish",
    "eslint": "eslint .",
    "prettier": "prettier --write .",
    "prettier:check": "prettier -c .",
    "test": "mocha -r tsx ./test/src/*.test.ts ./test/src/**/*.test.ts ./test/src/**/**/*.test.ts",
    "test:coverage": "c8 --all --reporter cobertura --reporter text --reporter lcov --reporter html npm run test"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "overrides": {
    "external-editor": {
      "tmp": ">=0.2.6"
    },
    "commitizen": {
      "lodash": ">=4.17.24",
      "inquirer": {
        "external-editor": {
          "tmp": ">=0.2.6"
        }
      }
    },
    "mocha": {
      "diff": ">=8.0.3",
      "serialize-javascript": ">=7.0.5"
    },
    "sinon": {
      "diff": ">=8.0.3"
    },
    "@cucumber/cucumber": {
      "tmp": ">=0.2.6"
    }
  },
  "dependencies": {
    "@node-in-layers/core": "^1.18.3",
    "@node-in-layers/deepgram": "^1.0.5",
    "@node-in-layers/youtube": "^1.0.1",
    "argparse": "^2.0.1",
    "es-main": "^1.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.0",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.12.0",
    "@types/chai-as-promised": "^8.0.1",
    "@types/lodash": "^4.17.13",
    "@types/mocha": "^9.1.1",
    "@types/node": "^22.19.20",
    "@types/proxyquire": "^1.3.31",
    "@types/sinon": "^17.0.3",
    "@typescript-eslint/eslint-plugin": "8.13.0",
    "@typescript-eslint/parser": "8.13.0",
    "@typescript/native-preview": "^7.0.0-dev.20260604.1",
    "c8": "^11.0.0",
    "chai": "^4.2.0",
    "chai-as-promised": "^7.1.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-functional": "~7.1.0",
    "eslint-plugin-import": "^2.31.0",
    "esprima": "^4.0.1",
    "globals": "^15.12.0",
    "mocha": "^11.0.1",
    "prettier": "^3.3.3",
    "proxyquire": "^2.1.3",
    "sinon": "^21.0.1",
    "sinon-chai": "^3.5.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.4.0",
    "tsx": "^4.19.2",
    "typescript": "5.3.3"
  }
}
