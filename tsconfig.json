{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["ES2023", "ESNext.Array", "es2021", "dom", "es2015"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "./src",
    "allowJs": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "./dist",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": false,
    "types": ["node"],
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "ts-node": {
    "esm": true
  },
  "include": ["./src"],
  "exclude": [
    "bin",
    "src/index.d.ts",
    "node_modules",
    "dist",
    "features",
    "container",
    "test"
  ]
}
